<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#16161A"
    android:orientation="vertical"
    android:paddingLeft="10dp"
    android:paddingTop="8dp"
    android:paddingRight="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/lang"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/key_bg"
            android:gravity="center"
            android:minWidth="88dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:textColor="#F4F4F5"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="#A1A1AA"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/settings"
            android:layout_width="44dp"
            android:layout_height="34dp"
            android:background="@drawable/key_bg"
            android:gravity="center"
            android:text="•••"
            android:textColor="#F4F4F5"
            android:textSize="14sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="132dp">

        <ImageView
            android:id="@+id/mic"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center"
            android:background="@drawable/mic_idle"
            android:contentDescription="Microphone"
            android:scaleType="center"
            android:src="@drawable/mic_glyph" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/next_ime"
            style="@style/HlasKey"
            android:layout_width="56dp"
            android:text="ABC"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/space"
            style="@style/HlasKey"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="space" />

        <TextView
            android:id="@+id/backspace"
            style="@style/HlasKey"
            android:layout_width="64dp"
            android:text="⌫" />

        <TextView
            android:id="@+id/enter"
            style="@style/HlasKey"
            android:layout_width="64dp"
            android:text="⏎" />
    </LinearLayout>
</LinearLayout>
